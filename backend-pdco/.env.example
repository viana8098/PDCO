# ============================================================================
# Configuração do backend NestJS do PDCO
# Copie para .env e ajuste. Aplicação irmã do PPR/PRESIDENTE — só roda local,
# contra o dw real, para gerar o snapshot estático consumido pelo deploy
# (ver frontend-pdco/scripts/gerar-snapshot.ts). Nunca fica no ar em produção.
# ============================================================================

PORT=8020

# Origens permitidas para CORS (frontend local). Separe por vírgula.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# ---------------------------------------------------------------------------
# SQL Server — dw corporativo (fato_planejamento_planodeacao e
# acompanhamentos, somente leitura). Suporta instância nomeada no formato
# SERVIDOR\INSTANCIA.
# ---------------------------------------------------------------------------
SQL_SERVER=SERVIDOR\INSTANCIA
SQL_DATABASE=dw
SQL_USER=
SQL_PASSWORD=
